# florrfarm.cc.cd 官网 + 安装包镜像. deploy/mirror/install.sh 把它装到 /etc/caddy/sites.d/.
# 前面是 Cloudflare 代理(SSL 模式 Full (strict)). 证书由 Caddy 经 HTTP-01 自动签, 所以
# Cloudflare 的「Always Use HTTPS」要保持关闭, 否则证书续期会失败(跳转由 Caddy 自己做).
florrfarm.cc.cd {
	encode gzip

	# 使用统计(deploy/stats): 程序心跳 + 官网下载按钮计数, 转给本机的 florr-stats.
	# Cloudflare 带来的 CF-Connecting-IP 原样转过去, florr-stats 查完地区就丢
	handle /api/t {
		reverse_proxy 127.0.0.1:8787
	}

	# 问题报告: 用户在程序里点了「上报」才会发来(脱敏过的错误信息)。用户的程序没有后台密码, 所以
	# 不放在 /admin 后面; 体积上限在这一层先挡一道(florr-stats 自己也限, stats_server.BUG_BODY_LIMIT)
	handle /api/bug {
		request_body {
			max_size 40KB
		}
		reverse_proxy 127.0.0.1:8787
	}

	# 问题报告的附件(最近 5 分钟录像 / 截图 / 日志的 zip, 客户端 blackbox.py 打的): 先 POST /api/bug 拿到一次性令牌才传得进去,
	# 上限比 florr-stats 自己的 ATTACH_LIMIT(20MB)略大
	handle /api/bug/* {
		request_body {
			max_size 21MB
		}
		reverse_proxy 127.0.0.1:8787
	}

	# 后台面板. 密码文件由 deploy/stats/install.sh 生成; 没装统计时 deploy/mirror/install.sh
	# 放一个一律 403 的占位 —— 宁可打不开, 也不能不设密码就对外
	handle /admin* {
		import /etc/caddy/florrfarm-admin.auth
		reverse_proxy 127.0.0.1:8787
	}

	# florr-auto-afk 的安装包(只有 v1.1.1 一个版本, 不再更新): 国内直连 GitHub 下不动,
	# 走这里。文件由 deploy/mirror/fetch_afk.sh 放进来, 不在 download/ 里(那里会被
	# mirror_sync.py 的 prune 清理). 只给真存在的文件加 immutable, 理由同 /download/*
	handle /afk/* {
		root * /var/lib/florrfarm
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 版本清单: 不缓存, 新版本一发布就能看到
	handle /latest.json {
		root * /var/lib/florrfarm
		header Cache-Control "no-cache"
		file_server
	}

	# 安装包: 文件名带版本号, 内容永远不变, 可以永久缓存. 只给真存在的文件加 ——
	# 404 也永久缓存的话, 还没同步到的包在 Cloudflare / 浏览器里会一直是 404
	handle /download/* {
		root * /var/lib/florrfarm
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 网站本体: mirror_sync.py 从公开仓库拉下来的 site/
	handle {
		root * /var/lib/florrfarm/site-repo/site
		header Cache-Control "public, max-age=300"
		file_server
	}
}
